# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jarvisku

# JWT secrets (generate strong random values)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# OpenAI (voice assistant + TTS). Optional for local dev.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# OpenRouter — chat AI. Dipakai bila OPENAI_API_KEY kosong/dummy.
# Buat key gratis di https://openrouter.ai/keys (format sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# CORS
CORS_ORIGIN=http://localhost:8081

# Local dev server port (backend/edge-functions)
PORT=8888
